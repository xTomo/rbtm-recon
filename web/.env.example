# Скопируйте в web/.env (рядом с docker-compose.yml) и задайте значение.
# Общий секрет recon-service и rbtm-web: тот же RECON_TOKEN задаётся в окружении rbtm-web.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Пустой токен — сервис отвечает 503 на всё, кроме /health.
RECON_TOKEN=
